# Copy to .env and fill in. Leave the VITE_FIREBASE_* values empty to run in demo mode
# (local browser storage + simulated sensors). These are public web-app config values, not secrets,
# but never put a service-account key in the frontend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: URL of a Python ML service that scores maintenance risk (see ml/README.md)
VITE_ML_API_URL=
